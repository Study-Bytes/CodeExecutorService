# Temporary localhost-only host port for VPS Nginx until BFF/reverse proxy is ready.
# Docker publishes 127.0.0.1:<port>:8084, not a public <vps-ip>:<port> listener.
CODE_EXECUTOR_SERVICE_PORT=8084

# Shared external Docker network for inter-service communication.
# Create it once with: docker network create studybytes_backend_net
CODE_EXECUTOR_BACKEND_NETWORK=studybytes_backend_net

# CodeExecutorService runtime
SERVER_PORT=8084
